{
  "family": "banktrace-otel-collector",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::234360897564:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "otel-collector",
      "image": "234360897564.dkr.ecr.us-east-2.amazonaws.com/banktrace-otel-collector:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4317,
          "protocol": "tcp"
        },
        {
          "containerPort": 4318,
          "protocol": "tcp"
        },
        {
          "containerPort": 8888,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NEW_RELIC_LICENSE_KEY",
          "value": "TU_NEW_RELIC_KEY"
        }
      ]
    }
  ]
}
