# .env — variables globales del proyecto BankTrace
 
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012          # tu account ID real
 
# New Relic
NEW_RELIC_LICENSE_KEY=NRAK-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEW_RELIC_OTLP_ENDPOINT=otlp.nr-data.net:4317
 
# DynamoDB
TRANSACTIONS_TABLE=banktrace-transactions
 
# Nombre de servicios (usado en OTel resource)
ACCOUNT_SERVICE_NAME=account-service
TRANSACTION_SERVICE_NAME=transaction-service
SERVICE_VERSION=1.0.0
DEPLOYMENT_ENV=production
